# Default mock-first mode works without any credentials.
POS_ADAPTER=mock
ORDER_ENGINE_MODE=deterministic

# OpenAI (server-side only)
OPENAI_API_KEY=
OPENAI_ORDER_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize

# Lightspeed Restaurant K-Series OAuth2 access (server-side only)
LIGHTSPEED_BASE_URL=https://api.lsk.lightspeed.app
LIGHTSPEED_ACCESS_TOKEN=
LIGHTSPEED_BUSINESS_LOCATION_ID=
LIGHTSPEED_MENU_ID=

# Raw audio/transcript retention is always off unless explicitly set to true.
DEBUG_RETAIN_CONVERSATION=false
