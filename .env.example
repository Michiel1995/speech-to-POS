# Default mock-first mode works without any credentials.
POS_ADAPTER=mock
ORDER_ENGINE_MODE=deterministic

# Offline speech paths are injected automatically by the Windows desktop app.
# Set these only when testing the standalone web server locally.
LOCAL_WHISPER_CLI=
LOCAL_WHISPER_SERVER=
LOCAL_WHISPER_MODEL=
LOCAL_WHISPER_MODELS_DIRS=
LOCAL_WHISPER_VAD_MODEL=
LOCAL_WHISPER_THREADS=4
LOCAL_WHISPER_MODEL_POLICY=adaptive
LOCAL_WHISPER_MAX_THREADS=6
LOCAL_WHISPER_TARGET_LATENCY_MS=30000
LOCAL_WHISPER_IDLE_UNLOAD_MS=180000

# Lightspeed Restaurant K-Series OAuth2 access (server-side only)
LIGHTSPEED_BASE_URL=https://api.lsk.lightspeed.app
LIGHTSPEED_ACCESS_TOKEN=
LIGHTSPEED_BUSINESS_LOCATION_ID=
LIGHTSPEED_MENU_ID=

# Raw audio/transcript retention is always off unless explicitly set to true.
DEBUG_RETAIN_CONVERSATION=false
